---
const types = [
  {
    name: "Nhà phố – đường 7,5 m",
    area: "Từ 100 m²",
    desc: "Lô nằm trong các tuyến nội khu yên tĩnh, vừa túi tiền, hợp để xây nhà ở cho gia đình trẻ.",
  },
  {
    name: "Shophouse – trục 10,5 – 15 m",
    area: "Từ 100 m²",
    desc: "Mặt tiền lớn gần chợ Lai Nghi, thuận lợi mở cửa hàng, quán cà phê, homestay đón khách du lịch.",
  },
  {
    name: "Biệt thự – nghỉ dưỡng",
    area: "Đến 300 m²",
    desc: "Lô rộng gần công viên và mặt nước, dành cho biệt thự sân vườn hoặc villa cho thuê nghỉ dưỡng.",
  },
  {
    name: "Khu Home Lake",
    area: "Nhà ở ven hồ",
    desc: "Cụm nhà hướng hồ cảnh quan nội khu, được quy hoạch cho mô hình homestay ven hồ.",
  },
];

const layouts = [
  { src: "/images/mat-bang-giai-doan-1-new-green-villa-hoi-an.webp", alt: "Mặt bằng giai đoạn 1 New Green Villa Hội An" },
  { src: "/images/mat-bang-phan-lo-new-green-villa-hoi-an.webp", alt: "Mặt bằng phân lô chi tiết New Green Villa Hội An" },
];
---
<section id="mat-bang" class="floorplan">
  <div class="container">
    <div class="section-heading">
      <h2>MẶT BẰNG NEW GREEN VILLA HỘI AN</h2>
      <span class="heading-line"></span>
    </div>

    <p class="floorplan-intro">
      Mặt bằng <strong>New Green Villa Hội An</strong> được quy hoạch theo hai dòng sản phẩm chính: nhà phố – shophouse
      và biệt thự – nghỉ dưỡng. Đường nội khu rộng 7,5 m, 10,5 m và 15 m chia khu đất thành các ô phố vuông vức.
      Khoảng một phần tư diện tích dành cho cây xanh, mặt nước và ba công viên rải đều. Kiến trúc hiện đại được
      phối cùng nét Á Đông quen thuộc của Hội An, tạo nên một khu dân cư vừa mới mẻ vừa gần gũi.
    </p>

    <div class="floorplan-banner">
      <img src="/images/mat-bang-tong-the-new-green-villa-hoi-an.webp" alt="Mặt bằng tổng thể khu dân cư Cầu Hưng – Lai Nghi (New Green Villa Hội An)" loading="lazy" />
    </div>

    <p class="floorplan-lead">
      Cơ cấu giai đoạn 1 (khoảng 20 ha): 47.490 m² đất biệt thự (109 lô), 35.220 m² đất nhà phố – shophouse (198 lô),
      20.140 m² công viên cây xanh, 19.500 m² đất dịch vụ và 74.840 m² giao thông, hạ tầng. Giai đoạn 2 (khoảng 45 ha)
      và giai đoạn 3 (khoảng 46 ha) tiếp nối về phía ven sông.
    </p>

    <div class="type-grid">
      {types.map((t) => (
        <div class="type-card">
          <h3>{t.name}</h3>
          <p class="type-area">{t.area}</p>
          <p class="type-desc">{t.desc}</p>
        </div>
      ))}
    </div>

    <div class="layout-grid">
      {layouts.map((l) => (
        <button type="button" class="layout-item" data-lightbox-trigger>
          <img src={l.src} alt={l.alt} loading="lazy" />
        </button>
      ))}
    </div>

    <div class="lightbox" id="lightbox" data-lightbox>
      <button type="button" class="lightbox-close" aria-label="Đóng">✕</button>
      <img src="" alt="" id="lightbox-img" />
    </div>
  </div>
</section>

<style>
.floorplan { background: var(--color-mist); padding-top: 0px; padding-bottom: 16px; }
.section-heading {
  text-align: center;
  margin-bottom: 16px;
}
.section-heading h2 {
  font-family: var(--font-body);
  color: var(--color-ink);
  letter-spacing: 0.04em;
  font-size: 1.6rem;
  font-weight: 700;
}
.heading-line {
  display: block;
  width: 40px;
  height: 2px;
  background: var(--color-clay);
  margin: 14px auto 0;
}

  .floorplan-intro {
    max-width: 100%;
    margin: 0 auto 20px;
    text-align: justify;
    color: #3d4d49;
    line-height: 1.75;
  }

  .floorplan-banner {
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 20px;
  }
  .floorplan-banner img {
    width: 100%;
    display: block;
  }

  .floorplan-lead {
    max-width: 100%;
    margin: 0 auto 20px;
    text-align: justify;
    color: #3d4d49;
    line-height: 1.75;
  }

  .type-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 24px;
  }
  .type-card {
    background: white;
    border: 1px solid rgba(18,46,43,0.1);
    border-radius: 6px;
    padding: 28px;
  }
  .type-card h3 {
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  .type-area {
    color: var(--color-clay);
    font-weight: 600;
    margin-bottom: 12px;
  }
  .type-desc {
    font-size: 0.92rem;
    color: #5c6b66;
    line-height: 1.6;
  }

  .layout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .layout-item {
    border-radius: 8px;
    overflow: hidden;
  }
  .layout-item img {
    width: 100%;
    display: block;
  }
.layout-item {
  border: none;
  padding: 0;
  cursor: pointer;
  background: none;
}
.layout-item img {
  transition: transform 0.3s ease;
}
.layout-item:hover img {
  transform: scale(1.03);
}

.lightbox {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(10, 20, 18, 0.92);
  z-index: 200;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.lightbox.is-open { display: flex; }
.lightbox img {
  max-width: 100%;
  max-height: 90vh;
  border-radius: 6px;
}
.lightbox-close {
  position: absolute;
  top: 24px;
  right: 24px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  color: white;
  border: none;
  font-size: 1.2rem;
  cursor: pointer;
}
@media (max-width: 860px) {
  .floorplan { padding-top: 8px; }
  .floorplan-intro {
    margin-bottom: 16px;
    text-align: justify;
  }
  .floorplan-banner { margin-bottom: 16px; }
  .floorplan-lead {
    margin-bottom: 24px;
    text-align: justify;
  }
  .type-grid { grid-template-columns: 1fr; margin-bottom: 32px; }
  .layout-grid { grid-template-columns: 1fr; }
}
</style>
<script>
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const triggers = document.querySelectorAll("[data-lightbox-trigger]");
  const closeBtn = lightbox?.querySelector(".lightbox-close");

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const img = trigger.querySelector("img");
      if (img && lightboxImg) {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightbox?.classList.add("is-open");
      }
    });
  });

  function closeLightbox() {
    lightbox?.classList.remove("is-open");
  }

  closeBtn?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });
</script>