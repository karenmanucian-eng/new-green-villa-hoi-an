---
import { FORM_ACTION, ENTRY_NAME, ENTRY_PHONE, ENTRY_NOTE } from "../config";
---
<div class="popup-overlay" id="popup-overlay">
  <div class="popup-card">
    <button type="button" class="popup-close" id="popup-close" aria-label="Đóng">✕</button>

    <div class="popup-icon">
      <img src="/images/file-bang-gia.png" alt="Bảng giá New Green Villa Hội An" class="icon-img" />
      <span class="icon-filename">banggianewgreenvilla.xlsx</span>
    </div>

    <div class="popup-heading">
      <p class="popup-title">ĐĂNG KÝ NHẬN BÁO GIÁ</p>
      <p class="popup-project">NEW GREEN VILLA HỘI AN</p>
      <p class="popup-date" id="popup-date"></p>
    </div>

    <form
      class="popup-form"
      id="popup-form"
      action={FORM_ACTION}
      method="POST"
      target="hidden-google-form"
    >
      <input type="text" name={ENTRY_NAME} placeholder="Họ và tên *" required />
      <input type="tel" name={ENTRY_PHONE} placeholder="Số điện thoại *" required />

      <div class="popup-checks">
        <label><input type="checkbox" class="popup-type" value="Nhà phố" /> Nhà phố</label>
        <label><input type="checkbox" class="popup-type" value="Shophouse" /> Shophouse</label>
        <label><input type="checkbox" class="popup-type" value="Biệt thự" /> Biệt thự</label>
        <label><input type="checkbox" class="popup-type" value="Home Lake" /> Home Lake</label>
      </div>
      <input type="hidden" name={ENTRY_NOTE} id="popup-note" />

      <button type="submit" class="popup-submit">ĐĂNG KÝ NHẬN BÁO GIÁ</button>
    </form>

    <div class="success-screen" id="popup-success">
      <svg class="success-check" viewBox="0 0 52 52">
        <circle cx="26" cy="26" r="25" fill="none" />
        <path fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
      </svg>
      <p class="success-title">Đăng ký thành công!</p>
      <p class="success-sub">Chúng tôi sẽ liên hệ bạn sớm nhất.</p>
    </div>
  </div>
</div>

<style>
  .popup-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10, 20, 18, 0.75);
    z-index: 300;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .popup-overlay.is-open { display: flex; }

  .popup-card {
    position: relative;
    background: white;
    border-radius: 10px;
    width: 100%;
    max-width: 420px;
    padding: 28px 28px 32px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  }
  .popup-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: rgba(18,46,43,0.08);
    color: var(--color-ink);
    font-size: 0.95rem;
    cursor: pointer;
  }

  .popup-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }
  .icon-img {
    width: 72px;
    height: 72px;
    object-fit: contain;
  }
  .icon-filename {
    color: #5c6b66;
    font-size: 0.8rem;
    font-family: var(--font-body);
  }

  .popup-heading {
    text-align: center;
    margin-bottom: 22px;
  }
  .popup-title {
    color: #c0392b;
    font-weight: 700;
    font-size: 1.3rem;
    margin-bottom: 4px;
  }
  .popup-project {
    color: var(--color-ink);
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 4px;
  }
  .popup-date {
    color: #7a8783;
    font-size: 0.82rem;
  }

  .popup-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .popup-form input[type="text"],
  .popup-form input[type="tel"] {
    padding: 12px 14px;
    border: 1px solid rgba(18,46,43,0.2);
    border-radius: 4px;
    font-size: 0.92rem;
    font-family: var(--font-body);
  }

  .popup-checks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    font-size: 0.9rem;
    color: #3d4d49;
  }
  .popup-checks label {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .popup-submit {
    margin-top: 4px;
    background: var(--color-ink);
    color: white;
    border: none;
    padding: 14px;
    border-radius: 4px;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    font-family: var(--font-body);
    transition: background 0.2s ease;
  }
  .popup-submit:hover { background: #0d2624; }

  @media (max-width: 480px) {
    .popup-card { padding: 22px 20px 26px; }
  }
  .success-screen {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 20px 0 8px;
  }
  .success-screen.is-visible { display: flex; }

  .success-check {
    width: 72px;
    height: 72px;
    margin-bottom: 16px;
  }
  .success-check circle {
    stroke: #1e7e34;
    stroke-width: 2;
    stroke-dasharray: 166;
    stroke-dashoffset: 166;
    animation: draw-circle 0.5s ease forwards;
  }
  .success-check path {
    stroke: #1e7e34;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    animation: draw-check 0.35s ease forwards 0.45s;
  }
  @keyframes draw-circle {
    to { stroke-dashoffset: 0; }
  }
  @keyframes draw-check {
    to { stroke-dashoffset: 0; }
  }

  .success-title {
    color: var(--color-ink);
    font-weight: 700;
    font-size: 1.15rem;
    margin-bottom: 6px;
  }
  .success-sub {
    color: #5c6b66;
    font-size: 0.92rem;
  }
</style>

<script>
  const overlay = document.getElementById("popup-overlay");
  const closeBtn = document.getElementById("popup-close");
  const dateEl = document.getElementById("popup-date");

  if (dateEl) {
    const today = new Date();
    const dd = String(today.getDate()).padStart(2, "0");
    const mm = String(today.getMonth() + 1).padStart(2, "0");
    const yyyy = today.getFullYear();
    dateEl.textContent = `NGÀY: ${dd}/${mm}/${yyyy}`;
  }

  const alreadyClosed = sessionStorage.getItem("ngv-popup-closed");

  if (!alreadyClosed) {
    setTimeout(() => {
      overlay?.classList.add("is-open");
    }, 10000);
  }

  function closePopup() {
    overlay?.classList.remove("is-open");
    sessionStorage.setItem("ngv-popup-closed", "1");
  }

  closeBtn?.addEventListener("click", closePopup);
  overlay?.addEventListener("click", (e) => {
    if (e.target === overlay) closePopup();
  });
  const popupForm = document.getElementById("popup-form");
  const popupNote = document.getElementById("popup-note");
  const popupSuccess = document.getElementById("popup-success");
  const typeChecks = document.querySelectorAll(".popup-type");

popupForm?.addEventListener("submit", () => {
    const selected = Array.from(typeChecks)
      .filter((c) => c.checked)
      .map((c) => c.value)
      .join(", ");
    if (popupNote) popupNote.value = selected;

    if (typeof gtag_report_conversion === "function") {
      gtag_report_conversion();
    }

    setTimeout(() => {
      popupForm.style.display = "none";
      popupSuccess?.classList.add("is-visible");
    }, 700);
  });
</script>