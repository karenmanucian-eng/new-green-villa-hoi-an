---
// Khung chung cho mọi bài viết trong thư mục src/pages/tin-tuc/
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_URL, PHONE, PHONE_TEL, ZALO_URL, COMPANY } from "../config";

const { frontmatter, url } = Astro.props;
const { title, description, image, imageAlt, date } = frontmatter;
const path = url || Astro.url.pathname;
const d = new Date(date);
const ngay = `${String(d.getDate()).padStart(2, "0")}/${String(d.getMonth() + 1).padStart(2, "0")}/${d.getFullYear()}`;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  image: `${SITE_URL}${image}`,
  datePublished: date,
  dateModified: date,
  mainEntityOfPage: `${SITE_URL}${path}`,
  author: { "@type": "Organization", name: COMPANY },
  publisher: {
    "@type": "Organization",
    name: "New Green Villa Hội An",
    logo: { "@type": "ImageObject", url: `${SITE_URL}/images/logo-new-green-villa-hoi-an-color.webp` },
  },
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Trang chủ", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Tin tức", item: `${SITE_URL}/tin-tuc` },
    { "@type": "ListItem", position: 3, name: title, item: `${SITE_URL}${path}` },
  ],
};
---
<Layout title={`${title} | New Green Villa Hội An`} description={description} path={path} image={image} type="article">
  <Header />
  <main id="top" class="article-page">
    <div class="container narrow">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a> <span>›</span> <a href="/tin-tuc">Tin tức</a> <span>›</span> <em>{title}</em>
      </nav>

      <article>
        <h1>{title}</h1>
        <p class="meta">Ngày đăng: <time datetime={date}>{ngay}</time> · New Green Villa Hội An</p>
        <p class="sapo">{description}</p>
        <img class="cover" src={image} alt={imageAlt || title} />
        <div class="content">
          <slot />
        </div>
      </article>

      <aside class="cta">
        <p class="cta-title">Nhận bảng giá & giỏ hàng mới nhất New Green Villa Hội An</p>
        <p>Chuyên viên tư vấn sẽ gửi bảng giá, sơ đồ lô trống và hỗ trợ xem đất thực tế.</p>
        <div class="cta-actions">
          <a class="btn-call" href={`tel:${PHONE_TEL}`}>Gọi {PHONE}</a>
          <a class="btn-zalo" href={ZALO_URL} target="_blank" rel="noopener">Chat Zalo</a>
          <a class="btn-form" href="/#lien-he">Đăng ký nhận bảng giá</a>
        </div>
      </aside>

      <p class="back"><a href="/tin-tuc">← Xem tất cả tin tức</a></p>
    </div>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Layout>

<style>
  .article-page { padding: 32px 0 48px; background: var(--color-mist); }
  .narrow { max-width: 860px; }
  .breadcrumb { font-size: 0.85rem; color: #5c6b66; margin-bottom: 18px; }
  .breadcrumb a { color: var(--color-brass); }
  .breadcrumb span { margin: 0 6px; }
  .breadcrumb em { font-style: normal; }
  h1 {
    font-family: var(--font-body);
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink);
    margin-bottom: 10px;
  }
  .meta { font-size: 0.85rem; color: #7a8783; margin-bottom: 18px; }
  .sapo { font-weight: 600; color: #3d4d49; line-height: 1.7; margin-bottom: 20px; text-align: justify; }
  .cover { width: 100%; border-radius: 8px; margin-bottom: 24px; }
  .content { color: #2e3d3a; line-height: 1.8; font-size: 1.02rem; }
  .content :global(h2) {
    font-family: var(--font-body);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 30px 0 12px;
    padding-left: 12px;
    border-left: 4px solid var(--color-brass);
  }
  .content :global(h3) { font-family: var(--font-body); font-size: 1.1rem; font-weight: 700; margin: 22px 0 10px; }
  .content :global(p) { margin-bottom: 14px; text-align: justify; }
  .content :global(ul), .content :global(ol) { margin: 0 0 16px 22px; }
  .content :global(li) { margin-bottom: 6px; }
  .content :global(img) { width: 100%; border-radius: 8px; margin: 10px 0 6px; }
  .content :global(em) { display: block; text-align: center; font-size: 0.88rem; color: #7a8783; margin-bottom: 16px; }
  .content :global(a) { color: var(--color-clay); text-decoration: underline; }
  .content :global(table) { width: 100%; border-collapse: collapse; margin-bottom: 18px; font-size: 0.95rem; }
  .content :global(th), .content :global(td) { border: 1px solid #dfe6e1; padding: 8px 10px; text-align: left; }
  .content :global(th) { background: var(--color-ink); color: var(--color-sand); }

  .cta { background: var(--color-ink); color: var(--color-sand); border-radius: 8px; padding: 26px; margin: 34px 0 20px; text-align: center; }
  .cta-title { color: #fff; font-weight: 700; font-size: 1.15rem; margin-bottom: 8px; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 16px; }
  .cta-actions a { padding: 11px 18px; border-radius: 4px; font-weight: 700; font-size: 0.92rem; }
  .btn-call { background: #c0392b; color: #fff; }
  .btn-zalo { background: #0068ff; color: #fff; }
  .btn-form { background: var(--color-brass); color: var(--color-ink); }
  .back a { color: var(--color-brass); font-weight: 600; }
</style>
