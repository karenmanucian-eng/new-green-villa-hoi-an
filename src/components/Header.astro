---
import { PHONE, PHONE_TEL } from "../config";
---
<header class="site-header">
  <div class="container header-inner">
    <a href={`tel:${PHONE_TEL}`} class="header-phone">
      <span class="phone-number">{PHONE}</span>
    </a>
    <a href="/" class="logo" title="New Green Villa Hội An">
      <img src="/images/logo-new-green-villa-hoi-an.webp" alt="Logo New Green Villa Hội An - Hội An Green Village" />
    </a>
    <nav class="nav-links" id="nav-links">
      <a href="/#tong-quan">Tổng quan</a>
      <a href="/#chinh-sach">Chính sách</a>
      <a href="/#vi-tri">Vị trí</a>
      <a href="/#mat-bang">Mặt bằng</a>
      <a href="/#tien-ich">Tiện ích</a>
      <a href="/#bang-gia">Bảng giá</a>
      <a href="/tin-tuc">Tin tức</a>
      <a href="/#lien-he">Liên hệ</a>
    </nav>
    <button class="menu-toggle" id="menu-toggle" aria-label="Mở menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-ink);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 18px;
    position: relative;
  }
.header-phone {
  display: flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  color: white;
  font-weight: 700;
  font-size: 0.85rem;
  white-space: nowrap;
  border: 1.5px solid white;
  border-radius: 999px;
  padding: 8px 14px;
  animation: breathe 1.4s ease-in-out infinite;
}
.phone-icon { font-size: 0.95rem; }

@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

@keyframes blink-text {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
.logo {
  display: flex;
  align-items: center;
}
.logo img {
  height: 60px;
  width: auto;
}
  .nav-links {
    display: flex;
    gap: 20px;
    margin-left: 24px;
  }
  .nav-links a {
    white-space: nowrap;
    color: var(--color-sand);
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--color-brass); }
  .header-cta {
    background: var(--color-brass);
    color: var(--color-ink);
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 0.9rem;
  }
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .menu-toggle span {
    display: block;
    height: 2px;
    background: var(--color-mist);
    border-radius: 2px;
  }

@media (max-width: 1140px) {
.header-inner {
  justify-content: center;
  position: relative;
}
.header-phone {
  position: absolute;
  left: 12px;
  font-size: 0.72rem;
  padding: 6px 12px;
  border-width: 1px;
}
.phone-icon { font-size: 0.8rem; }
.logo img { height: 50px; }
   .logo { flex: 1; justify-content: center; margin-left: 96px; margin-right: 20px; }
.menu-toggle {
  position: absolute;
  right: 4px;
}
  .nav-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-ink);
    flex-direction: column;
    gap: 0;
    border-top: 1px solid rgba(238,242,237,0.1);
  }
  .nav-links.is-open { display: flex; }
.nav-links a {
  padding: 16px 24px;
  border-bottom: 1px solid rgba(238,242,237,0.08);
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
  .header-cta { display: none; }
  .menu-toggle { display: flex; }
}
@media (max-width: 420px) {
  .logo img { height: 40px; }
}
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("nav-links");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(!!isOpen));
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      nav.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>