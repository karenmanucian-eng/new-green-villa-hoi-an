---
import { PHONE, PHONE_TEL } from "../config";
---
<footer class="site-footer">
  <div class="container footer-inner">
    <span>© {new Date().getFullYear()} New Green Villa Hội An. Bản quyền thuộc về đơn vị phát triển dự án.</span>
    <div class="footer-links">
      <a href={`tel:${PHONE_TEL}`}>{PHONE}</a>
      <a href="/chinh-sach-bao-mat">Chính sách bảo mật</a>
      <a href="/dieu-khoan-su-dung">Điều khoản sử dụng</a>
      <a href="#top">Về đầu trang</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-ink); padding-block: 28px; }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .site-footer, .site-footer a { color: var(--color-sand); font-size: 0.85rem; }
  .footer-links { display: flex; gap: 20px; }
</style>